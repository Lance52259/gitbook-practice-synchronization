# gitbook-practice-synchronization 本地环境变量示例
# GitHub：https://github.com/chnsz/gitbook-practice-synchronization

# ---- Repo B (examples 源仓) ----
# 必填：owner/name，无内置默认值；如 huaweicloud/terraform-provider-huaweicloud
B_REPO=huaweicloud/terraform-provider-huaweicloud
B_REPO_TOKEN=
B_EXAMPLES_PATH=examples
B_DEFAULT_BRANCH=master

# ---- Repo C (docs target — PR 提交目标仓) ----
# 必填：owner/name，无内置默认值；如 chnsz/hcbp-demo
C_REPO=chnsz/hcbp-demo
# 正式推送（DRY_RUN=false）必填；dry-run 可空
C_REPO_TOKEN=
C_DOCS_ROOT=docs/zh-cn/best-practices
C_DEFAULT_BRANCH=master
C_SYNCED_MANIFEST=synced-practices.json

# ---- DeepSeek (OpenAI Compatible) ----
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=300
AI_MAX_RETRIES=2
# 完成长度上限；双语文档建议可设较高值。DeepSeek V4 硬上限约 384000
AI_MAX_TOKENS=300000

# ---- Runtime ----
SKILL_ID=best-practice-doc
DRY_RUN=true
# 单次最多生成条数（在「按服务跳过 open PR / 每服务每轮 1 条」过滤之后再截断）；0=不限制。联调建议设为 1
MAX_PRACTICES=1
STATE_PATH=state/state.json
WORK_DIR=.work
PR_MODE=one_per_practice
PR_UPDATE_MODE=skip
LOG_LEVEL=INFO
